# ---- Django ----
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000
TIME_ZONE=Asia/Kolkata

# ---- MySQL 8+ (required - there is no SQLite fallback) ----
DATABASE_NAME=dayflow_hrms
DATABASE_USER=dayflow
DATABASE_PASSWORD=change-me
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306

# ---- Email (optional; leave EMAIL_HOST empty to print emails to the console) ----
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# ---- Behaviour ----
REQUIRE_EMAIL_VERIFICATION=True
AUTO_HIRE_ON_ACCEPT=True

# ---- FastAPI service ----
FASTAPI_URL=http://localhost:8001
FASTAPI_PUBLIC_URL=http://localhost:8001
SERVICE_JWT_SECRET=change-me-shared-secret-between-django-and-fastapi
CORS_ALLOWED_ORIGINS=http://localhost:8000

# ---- AI (optional: only rewords answers the permission-checked tools already produced) ----
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5

# ---- docker-compose only ----
MYSQL_ROOT_PASSWORD=change-me-root
